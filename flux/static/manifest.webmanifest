{
  "name": "Flux — know what you can spend today",
  "short_name": "Flux",
  "description": "Know what you can safely spend today. Payments log themselves.",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f6f4ef",
  "theme_color": "#1f6b57",
  "icons": [{ "src": "/static/img/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }],
  "shortcuts": [
    { "name": "Plans", "url": "/app/plans" },
    { "name": "Add from SMS", "url": "/app/share" }
  ],
  "share_target": {
    "action": "/app/share",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}
