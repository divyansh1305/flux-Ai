# Copy this file to .env and fill in the values. NEVER commit .env.

# Required in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# "production" when deployed. Leave as development on your laptop.
FLUX_ENV=development

# Email sign-in codes (Gmail: create an App Password at myaccount.google.com/apppasswords)
# Without these, in development the code is printed in the terminal.
EMAIL_SENDER=
EMAIL_PASSWORD=

# Optional: Google Sign-In. Create an OAuth client (Web) in Google Cloud Console and add
# your site (e.g. http://127.0.0.1:5000) to "Authorised JavaScript origins".
GOOGLE_CLIENT_ID=
# Needed for "Connect Gmail" (same OAuth client, its secret)
GOOGLE_CLIENT_SECRET=

# Optional: AI coach + smarter voice understanding (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash


# Who can open the private numbers page /app/admin (comma-separated sign-in emails)
ADMIN_EMAILS=

# Where the Android app download points (built by GitHub Actions). Empty = hide the download.
# ANDROID_APK_URL=

# Business dates are in this timezone (servers usually run in UTC).
APP_TIMEZONE=Asia/Kolkata

# Observability. With METRICS_TOKEN set, Prometheus scrapes /metrics with "Authorization: Bearer <token>".
# Without it, /metrics is disabled in production.
METRICS_TOKEN=
# json (default in production) or text
LOG_FORMAT=
# gunicorn threads for the single worker (see gunicorn.conf.py)
WEB_THREADS=8

# Daily database backups (on the same disk) + optional off-site download at /admin/backup/latest
BACKUP_DIR=
BACKUP_TOKEN=
BACKUP_KEEP=14
