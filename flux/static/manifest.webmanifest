{
  "name": "Flux — Spend smarter, save automatically",
  "short_name": "Flux",
  "description": "Voice-first money app: scan & pay with a budget check, auto-save, and AI coaching.",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0b0b0b",
  "theme_color": "#0b0b0b",
  "icons": [{ "src": "/static/img/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }],
  "shortcuts": [
    { "name": "Scan & Pay", "url": "/app/pay" },
    { "name": "Add from SMS", "url": "/app/share" }
  ],
  "share_target": {
    "action": "/app/share",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}
